{
  "name": "listinghub",
  "version": "1.0.0",
  "description": "ListingHub - Nuxt Js Business Directory & Listing Template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "config:prod": "node -e \"require('fs').copyFileSync('nuxt.config.example.ts','nuxt.config.ts')\"",
    "clean": "node -e \"for(const d of ['.nuxt','.output']){try{require('fs').rmSync(d,{recursive:true,force:true,maxRetries:5,retryDelay:300})}catch(e){console.warn('clean skip',d,e.code)}}\"",
    "build:vercel": "npm run config:prod && npm run clean && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@casl/ability": "^6.7.3",
    "@casl/vue": "^2.2.6",
    "@nuxtjs/i18n": "^10.2.1",
    "@pinia/nuxt": "^0.11.3",
    "bootstrap": "^5.3.7",
    "dropzone": "^6.0.0-beta.2",
    "flag-icons": "^7.5.0",
    "laravel-echo": "^2.2.0",
    "multi-range-slider-vue": "^1.1.4",
    "nuxt": "^3.17.7",
    "pinia": "^3.0.4",
    "pusher-js": "^8.4.0",
    "quill": "^2.0.3",
    "sass": "^1.89.2",
    "swiper": "^11.2.10",
    "vue": "^3.5.17",
    "vue-chartjs": "^5.3.2",
    "vue-countup-v3": "^1.4.2",
    "vue-easy-lightbox": "^1.19.0",
    "vue-multiselect": "^3.2.0",
    "vue-router": "^4.5.1",
    "vue3-google-map": "^0.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2"
  }
}
