# -----------------------------------------------------------------------------
# Nuxt 3 — variables publiques (runtimeConfig.public)
# Préfixe NUXT_PUBLIC_ requis. Copier vers .env ou .env.local
# -----------------------------------------------------------------------------

# API Laravel (toujours terminer par /api si votre backend expose /api)
NUXT_PUBLIC_API_BASE=http://localhost:8000/api

# Numéro WhatsApp affiché (liens wa.me), format indicatif sans espaces superflus
NUXT_PUBLIC_WHATSAPP="+2250714158172"

# Chemin public du logo (fichier dans public/ ou assets servis)
NUXT_PUBLIC_LOGO=/logo_nadom.png

NUXT_PUBLIC_SITE_NAME=NADOM

# Pusher (temps réel / notifications) — laisser vide si non utilisé
NUXT_PUBLIC_PUSHER_KEY=
NUXT_PUBLIC_PUSHER_CLUSTER=ap2

# -----------------------------------------------------------------------------
# Développement (optionnel) — surveillance fichiers Windows / Docker
# -----------------------------------------------------------------------------
# CHOKIDAR_USEPOLLING=true
# CHOKIDAR_INTERVAL=1000
